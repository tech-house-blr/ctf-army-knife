{
    "name": "ctf-army-knife",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/web"
    ],
    "scripts": {
        "predev": "npm run cyberchef:build",
        "dev": "npm run dev -w @ctf-army-knife/web",
        "prebuild": "npm run cyberchef:build",
        "build": "npm run build -w @ctf-army-knife/web",
        "start": "npm run start -w @ctf-army-knife/web",
        "lint": "eslint",
        "cyberchef:import": "node scripts/cyberchef.mjs import",
        "cyberchef:baseline": "node scripts/cyberchef.mjs baseline",
        "cyberchef:setup": "node scripts/cyberchef.mjs setup",
        "cyberchef:build": "node scripts/cyberchef.mjs build",
        "cyberchef:verify": "node scripts/cyberchef.mjs verify",
        "cyberchef:test-upstream": "node scripts/cyberchef.mjs test-upstream",
        "test:integration": "node --test tests/cyberchef/*.test.mjs",
        "test:browser": "playwright test"
    },
    "engines": {
        "node": "24.x"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "eslint": "^9",
        "eslint-config-next": "16.3.4"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1"
        }
    }
}
